# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Production build
dist/
build/

# Capacitor native platforms
android/
ios/App/Pods/
ios/App/output/
ios/App/DerivedData/
ios/.build/

# Environment variables — match all .env* (.env, .env.local, .env.bak, .env.old, etc.)
.env
.env.*
!.env.example

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# Playwright test results
test-results/
playwright-report/

# Temporary folders
tmp/
temp/

# Push sender environment
push-sender/.env

# Le site est publié par la CI à partir de dist/ (GitHub Pages, source « GitHub Actions »).
# L'ancien dossier docs/ n'existe plus : s'il réapparaît (vieux script, vieille habitude),
# il ne doit jamais être commité.
docs/

# IMPORTANT: PROTECT CUSTOM DOMAIN FILE
# NEVER delete this file - it contains the custom domain configuration
!public/CNAME
# Android signing keys (never commit)
*.keystore
*.jks

# Python bytecode cache
__pycache__/
*.pyc

# oh-my-claudecode tool state
.omc/

# Claude Code personal settings (machine-local permissions)
.claude/settings.local.json

# Temporary one-off admin scripts (never commit)
scripts/tmp-set-admin-password.mjs

# Artefacts Android (générés, ne pas committer)
*.apk
*.aab
*.idsig
.gradle/
local.properties

# Résultats Playwright
.playwright-results/
