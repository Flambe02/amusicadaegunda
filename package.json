{
  "name": "musica-da-segunda",
  "private": true,
  "version": "2.0.12",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/export-songs-from-supabase.cjs && node scripts/generate-build-info.cjs && node scripts/generate-current-song-artwork.cjs && node scripts/optimize-brand-images.cjs",
    "build": "vite build",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "preview": "vite preview",
    "deploy": "npm run build",
    "cap:init": "cap init \"Música da Segunda\" com.tonorg.musicadasegunda || true",
    "cap:add:android": "cap add android || true",
    "cap:add:ios": "cap add ios || true",
    "cap:copy": "cap copy",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "cd android && gradlew.bat bundleRelease",
    "icons:ios": "cordova-res ios --skip-config --copy",
    "icons:android": "node scripts/generate-android-assets.js",
    "splash:android": "echo 'Splash screen géré par le script icons:android'",
    "assets:android": "npm run icons:android",
    "ci:android": "npm ci && npm run build && npx cap sync android",
    "sitemap": "node scripts/generate-sitemap-unified.cjs",
    "export:songs": "node scripts/export-songs-from-supabase.cjs",
    "predeploy": "npm run sitemap",
    "seo:verify": "node scripts/verify-sitemap-seo.cjs",
    "prepare": "husky install",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test:run && npm run test:e2e",
    "test:admin": "node scripts/test-admin-crud.js",
    "test:push": "node scripts/test-push-upsert.js",
    "postbuild": "node scripts/generate-sw-assets.cjs && node scripts/generate-stubs.cjs && node scripts/generate-sitemap-unified.cjs && node scripts/copy-to-docs.cjs && node scripts/ping-indexnow.cjs",
    "build:seo": "npm run export:songs && npm run build",
    "qa:jsonld": "node scripts/check-jsonld-prod.js",
    "qa:sitemap": "node scripts/check-sitemap-prod.js",
    "qa:prod": "npm run qa:jsonld && npm run qa:sitemap",
    "optimize:images": "node scripts/optimize-images.cjs",
    "optimize:brand-images": "node scripts/optimize-brand-images.cjs",
    "generate:tv-artwork": "node scripts/generate-tv-artwork.mjs",
    "pitch:map": "node scripts/generate-pitch-map.cjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@noriginmedia/norigin-spatial-navigation": "^3.2.1",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@supabase/supabase-js": "^2.90.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dompurify": "^3.3.0",
    "lucide-react": "^0.475.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.2.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "web-vitals": "^5.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.1",
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.7",
    "@vitest/ui": "^4.0.7",
    "autoprefixer": "^10.4.21",
    "cordova-res": "^0.15.4",
    "cross-env": "^10.0.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "fs-extra": "^11.3.2",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "lint-staged": "^16.1.5",
    "postcss": "^8.5.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vite": "^6.1.0",
    "vitest": "^4.0.7",
    "web-push": "^3.6.7"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": "cross-env NODE_ENV=production eslint --max-warnings=200 --rule 'no-console: off' --fix"
  },
  "engines": {
    "node": ">=18.17"
  },
  "overrides": {
    "date-fns": "^3.6.0"
  }
}
