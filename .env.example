# Configuration locale — Música da Segunda
# Copiez ce fichier vers .env et remplissez vos vraies valeurs (ne jamais committer .env)

# Supabase (Settings > API dans le dashboard Supabase)
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-supabase

# Web Push
VITE_VAPID_PUBLIC_KEY=votre-cle-publique-vapid
VITE_VAPID_KEY_VERSION=1
# Remplacez <PROJECT-REF> par la référence de votre projet Supabase
VITE_PUSH_API_BASE=https://<PROJECT-REF>.functions.supabase.co
